  {
    "section": "Key Coverage - Insured Person",
    "key": "Regulatory Investigation Cost",
    "bvalue": "Refer_To_Schedule",
    "mod": "",
    "def": "(Trigger: \"An investigation, administrative or regulatory inquiry or examination by an Enforcement Authority in connection with either the business of a Company or an Insured Person in his or her capacity as such; B. A written request made upon an Insured Person (including by the service of a target letter or Wells Notice) for an interview, a meeting, sworn testimony or the production of documents from an Enforcement Authority in connection with either the business of a Company or an Insured Person in his or her capacity as such; C. An internal investigation or inquiry conducted by the Company in response to the A. or B. above.\")",
    "ret": "Refer_To_Schedule",
    "type": "H",
    "anchor": "<1.5 Investigation Costs> /1.5B Investigation Costs and 1.24 Investigation Travel and Accommodation Costs/"
  },
  {
