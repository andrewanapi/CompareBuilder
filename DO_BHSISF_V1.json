    "ret": "Refer_To_Schedule",
    "type": "H",
    "anchor": "<1.5 Investigation Costs> /1.5B Investigation Costs and 1.24 Investigation Travel and Accommodation Costs/"
  },
  {
    "section": "Key Coverage - Insured Person",
    "key": "Dawn Raid, Pre-Investigation & Regulatory Raid Cost",
    "bvalue": "Refer_To_Schedule",
    "mod": "",
    "def": "(Trigger: \"A raid on or on-site visit to the Company or an Outside Entity by an Enforcement Authority that involves the production, review or copying of documents, or interviews of any Insured Person; B. A public announcement relating to Paragraph A.; C. Any formal notification to an Enforcement Authority of a suspected material breach of duty by an Insured Person; or D. An internal investigation conducted by the Company if and to the extent such investigation is requested by an Enforcement Authority following a formal notification given in C. above.\")",
    "ret": "Refer_To_Schedule",
    "type": "H",
    "anchor": "<1.7 Pre-Investigation Costs> /1.7 Pre-Investigation Costs/"
